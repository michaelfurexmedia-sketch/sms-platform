{
  "name": "sms-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview:legacy": "node scripts/serve.mjs",
    "build:worker": "tsc -p tsconfig.worker.json",
    "worker": "node --env-file-if-exists=.env dist/worker/apps/worker/index.js",
    "lint": "eslint src apps tests next.config.ts playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:components": "playwright test",
    "test:worker": "node --import tsx --test tests/worker.integration.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:worker && npm run build && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/geist": "^5.2.0",
    "bullmq": "^5.81.6",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.19.1"
}
