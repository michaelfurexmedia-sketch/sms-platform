{
  "name": "sms-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src apps tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:worker": "tsc -p tsconfig.worker.json",
    "worker": "node dist/worker/apps/worker/index.js",
    "test:worker": "node --import tsx --test tests/worker.integration.ts",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:worker && npm run build",
    "state:check": "node scripts/check-state.mjs",
    "preview:owner": "node scripts/owner-preview.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.0",
    "@fontsource/geist": "^5.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.28",
    "bullmq": "5.81.6",
    "ioredis": "5.11.1",
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
