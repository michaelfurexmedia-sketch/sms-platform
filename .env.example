# Phase 1: no provider credentials or live integrations.
APP_MODE=demo
APP_URL=http://localhost:3000
ENABLE_LIVE_SMS=false
ENABLE_LIVE_BILLING=false
QUEUE_URL=redis://127.0.0.1:6379
WORKER_HEALTH_PORT=3001
# Local development only; replace before using any shared host.
POSTGRES_PASSWORD=local-development-only

# Owner preview is disabled by default. Use npm run preview:owner on your own
# computer only; never enable it behind a tunnel, reverse proxy or hosted relay.
# OWNER_PREVIEW is deliberately not enabled here.

# Phase 3 owner provisioning: set privately at deployment; never grant by signup.
# Changing this value alone must not grant or transfer owner privileges.
OWNER_ADMIN_EMAIL=
